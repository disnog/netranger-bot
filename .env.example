# netranger-bot environment variables
# Copy this file to .env and fill in real values (never commit .env).

# --- Required ---
TOKEN=your-discord-bot-token-here
GUILD_ID=your-discord-guild-id-here

# --- MariaDB (netranger-db) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=netranger
DB_PASS=changeme
DB_NAME=netranger

# --- Channel / role names (optional, defaults shown) ---
WELCOMECHANNEL_NAME=welcome
MEMBERCHANNEL_NAME=general
LOGCHANNEL_NAME=cnc
MIRRORCHANNEL_NAME=mirror
MEMBERROLE_NAME=Members

# --- Email verification (optional — all required if any are set) ---
# SMTP_SERVER=mail.example.com
# SMTP_PORT=587
# SMTP_USERNAME=bot@example.com
# SMTP_PASSWORD=changeme
# SMTP_FROMEMAIL=noreply@example.com
# SECRETKEY=your-fernet-compatible-secret-key
